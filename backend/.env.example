# Servidor
PORT=3000
NODE_ENV=development

# Banco (docker-compose local)
MONGO_URI=mongodb://localhost:27017/clinica_hof

# Auth
JWT_ACCESS_SECRET=troque_este_valor_por_um_secret_forte
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque_este_valor_por_outro_secret_forte
JWT_REFRESH_EXPIRES_IN=30d

# Limite de sessões simultâneas por conta (seção 6.2 do levantamento)
MAX_ACTIVE_SESSIONS_PER_USER=3

# Billing — meses de trial gratuito no lançamento
TRIAL_MONTHS=4
